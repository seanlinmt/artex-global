# Docker 배포 설정 (이 파일을 복사해서 .env 로 만드세요)
# ARTEX_TAG 는 docker-compose 가 받는 이미지 ghcr.io/jiwoochris/artex-global 의 태그입니다.
# latest 는 가장 최근 릴리스를 가리키며, 특정 릴리스에 고정하려면 v* 태그를 적습니다.
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (둘 중 하나만 또는 둘 다 입력하세요. 비워 두고 나중에 UI 에서 설정해도 됩니다)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 첫 실행 보호 (관리자 계정 원격 선점 방지)
# - 웹/API 포트는 기본적으로 호스트의 127.0.0.1 에만 게시됩니다. 다른 기기에서 직접
#   접속해야 하면 ARTEX_BIND=0.0.0.0 으로 바꾸되, 초기 설정을 먼저 마치십시오.
# - 처음 기동하면 로그에 무작위 설정 토큰이 찍히고(docker compose logs artex),
#   /setup 화면에서 그 값을 입력해야 관리자 비밀번호를 만들 수 있습니다.
#   ARTEX_SETUP_TOKEN 을 지정하면 그 값이 토큰이 되고 로그에는 찍히지 않습니다.
# - ARTEX_ADMIN_PASSWORD 를 지정하면 /setup 없이 그 값으로 바로 초기화합니다(8자 이상).
#
# 인터페이스 선택: ARTEX_BIND 에 IP 를 직접 적어도 되지만, LAN 이나 Wi-Fi 중 하나만
# 노출하려면 ./bind.sh 를 쓰는 편이 안전합니다(DHCP 로 주소가 바뀌어도 다시 실행하면
# 현재 주소로 갱신됨).  ./bind.sh list 로 후보를 확인할 수 있습니다.
#   ./bind.sh local | lan | wifi | any      # 하나의 인터페이스만, 또는 전체
# 주의: 이 값은 게시 주소(호스트 인터페이스)만 정합니다. 컨테이너 내부의 eth0/eth1
# 두 네트워크(internal/external)는 docker-compose.yml 이 따로 구성하며, Docker
# Desktop 에서는 두 망 모두 같은 호스트 경로로 나갑니다. 자세한 내용은 README 의
# "네트워크 인터페이스 선택" 절을 보십시오.
ARTEX_BIND=127.0.0.1
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
# 브라우저 교차 출처(CORS) 허용 목록(쉼표 구분). 내장 UI 는 동일 출처라 비워 둡니다.
ARTEX_CORS_ORIGINS=

# 서버 쪽 기본 출력 언어(en·ko·zh·es·ja). 비우면 영어입니다.
# - 에이전트 리포트·요약·대화 응답과 서버 오류 메시지의 기본값이 되며, 설정 화면에서
#   "표시 언어"를 고르면 그 값이 우선합니다.
# - 서버 콘솔 로그는 이 값만 따릅니다(설정 화면 선택과 무관).
# - 웹 화면 문구의 언어는 브라우저마다 설정 화면에서 고릅니다(기본 영어).
ARTEX_LANG=
